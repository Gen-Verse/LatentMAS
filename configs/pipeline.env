# Global pipeline configuration.
#
# Sourced by scripts/run_pipeline.sh. Every value uses `${VAR:-default}` so it can
# be overridden inline without editing this file, e.g.:
#   BACKEND=vllm METHOD=baseline ./scripts/run_pipeline.sh

# ---- Pipeline stages (1 = run, 0 = skip) ----
RUN_TRAINING="${RUN_TRAINING:-0}"          # fine-tune with Unsloth before inference
RUN_INFERENCE="${RUN_INFERENCE:-1}"        # run evaluation

# ---- Model & task ----
MODEL_NAME="${MODEL_NAME:-Qwen/Qwen3-4B}"
METHOD="${METHOD:-latent_mas}"             # baseline | text_mas | latent_mas
TASK="${TASK:-gsm8k}"                      # gsm8k | aime2024 | aime2025 | gpqa | arc_easy | arc_challenge | mbppplus | humanevalplus | medqa | mgsm
MGSM_LANG="${MGSM_LANG:-en}"               # only used when TASK=mgsm
PROMPT="${PROMPT:-sequential}"             # sequential | hierarchical
SPLIT="${SPLIT:-test}"

# ---- Generation ----
DEVICE="${DEVICE:-cuda}"
MAX_SAMPLES="${MAX_SAMPLES:--1}"           # -1 = all samples
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-2048}"
LATENT_STEPS="${LATENT_STEPS:-3}"          # latent_mas only
TEMPERATURE="${TEMPERATURE:-0.6}"
TOP_P="${TOP_P:-0.95}"
GENERATE_BS="${GENERATE_BS:-20}"
SEED="${SEED:-42}"

# ---- Inference backend: hf | vllm | llamacpp ----
BACKEND="${BACKEND:-hf}"
# vLLM (BACKEND=vllm)
TENSOR_PARALLEL_SIZE="${TENSOR_PARALLEL_SIZE:-1}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.9}"
# llama.cpp (BACKEND=llamacpp); text generation only (not latent_mas)
LLAMACPP_MODEL_PATH="${LLAMACPP_MODEL_PATH:-}"   # path to a local .gguf file (required for llamacpp)
LLAMACPP_N_CTX="${LLAMACPP_N_CTX:-4096}"
LLAMACPP_N_GPU_LAYERS="${LLAMACPP_N_GPU_LAYERS:--1}"

# ---- Training (RUN_TRAINING=1); uses Unsloth ----
UNSLOTH_CONFIG="${UNSLOTH_CONFIG:-configs/unsloth_train.yaml}"

# ---- Output ----
RESULTS_DIR="${RESULTS_DIR:-results}"
